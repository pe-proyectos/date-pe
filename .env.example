# date.pe — plantilla de variables de entorno (copiar a .env y rellenar)

# --- App ---
APP_BASE_DOMAIN=date.pe
NODE_ENV=development
PORT=3000

# --- Base de datos ---
DATABASE_URL=postgres://user:password@localhost:5432/datepe

# --- Auth ---
JWT_SECRET=change-me
COOKIE_DOMAIN=.date.pe

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="date.pe <no-reply@date.pe>"

# --- Pagos: Culqi ---
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# --- Pagos: MercadoPago (opcional / split) ---
MERCADOPAGO_ACCESS_TOKEN=

# --- WhatsApp (Twilio o Meta Cloud API) ---
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Realtime / cache (opcional) ---
REDIS_URL=

# --- Storage: Cloudflare R2 (servido en r2.date.pe) ---
R2_PUBLIC_BASE_URL=https://r2.date.pe
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=datepe
