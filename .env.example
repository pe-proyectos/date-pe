# date.pe — plantilla de variables de entorno (copiar a .env y rellenar)

# --- App ---
APP_BASE_DOMAIN=date.pe
NODE_ENV=development
PORT=3000

# --- Base de datos ---
DATABASE_URL=postgres://user:password@localhost:5432/datepe

# --- Auth ---
JWT_SECRET=  # obligatorio en producción: openssl rand -hex 48
COOKIE_DOMAIN=.date.pe

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="date.pe <no-reply@date.pe>"

# --- Pagos: Culqi ---
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# --- Pagos: MercadoPago (opcional / split) ---
MERCADOPAGO_ACCESS_TOKEN=

# --- WhatsApp: DESACTIVADO por ahora (solo se muestra el WhatsApp de contacto
#     que cada barbería configure en su branding). Envío automático comentado. ---
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# --- Pagos ---
# URL pública para back_urls / return de las pasarelas
APP_PUBLIC_URL=https://date.pe
# En dev sin llaves: simula el pago para probar el flujo completo
PAYMENTS_DEV_MODE=true
# Culqi
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- Realtime / cache (opcional) ---
REDIS_URL=

# --- Storage: Cloudflare R2 (servido en r2.date.pe) ---
R2_PUBLIC_BASE_URL=https://r2.date.pe
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=datepe
# Contraseña del superadmin (admin@date.pe)
SUPERADMIN_PASSWORD=

# Notificaciones push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@date.pe
YOUTUBE_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
